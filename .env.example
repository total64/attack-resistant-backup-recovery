# Backend database (SQLite default; uncomment to select a managed SQL database)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/attack_resistant_db

# Browser API CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Internal component tokens: use long random secrets outside source control.
# Give the detector only security_events:write. Add individual backup,
# verification, isolation, and recovery workers only when those workers exist.
MVP_COMPONENT_TOKENS=

# Detector -> authenticated backend API
DETECTOR_API_URL=http://127.0.0.1:8000
DETECTOR_API_TOKEN=
DETECTOR_SOURCE=wazuh-detector
DETECTOR_ASSET_ID=
DETECTOR_ASSET_EXTERNAL_SOURCE=wazuh
DETECTOR_API_TIMEOUT_SECONDS=5
ALERTS_JSON_PATH=/var/ossec/logs/alerts/alerts.json

# Wazuh is read externally from the configured alert file; these optional
# settings do not imply that a Wazuh manager connection has been tested.
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_VERIFY_SSL=true

# Optional legacy database-only detector sink
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=attack_resistant_db
